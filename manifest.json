{
    "manifest_version": 3,
    "name": "Hide 'People You May Know' on Facebook",
    "version": "1.0.1",
    "description": "Hides 'People You May Know' section from your Facebook Feed and Profile.",
    "icons": {
        "48": "images/icon.png",
        "128": "images/icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.facebook.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}